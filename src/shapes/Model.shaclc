BASE <https://example.org/shapes#>
PREFIX acp: <http://www.w3.org/ns/solid/acp#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

shape <AccessControlResourceShape> -> acp:AccessControlResource {
    closed=true . 
    rdf:type IRI [1..1] .
    acp:resource IRI [1..1] .
    acp:accessControl @<AccessControlShape> [1..*] .
}

shape <AccessControlShape> -> acp:AccessControl {
    closed=true .
    rdf:type IRI [1..1] .
    acp:apply @<PolicyShape> [1..1] .
}

shape <PolicyShape> -> acp:Policy {
    closed=true . 
    rdf:type IRI [1..1] .
    acp:allow IRI [1..1] .
    acp:anyOf @<MatcherShape> [1..1] .
    acp:agentGroup @<AgentGroupShape> [0..*] .
    acp:public @<PublicShape> [0..1] .
}

shape <MatcherShape> -> acp:Matcher {
    closed=true .
    rdf:type IRI [1..1] .
    acp:agent IRI [1..1] .
}
